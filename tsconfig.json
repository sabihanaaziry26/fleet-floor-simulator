{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "cli/**/*.ts",
    "engine/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "frontend",
    "backend",
    "engine/tests"
  ]
}